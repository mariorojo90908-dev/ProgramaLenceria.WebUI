@page "/clientes"
@using ProgramaLenceria.Application.Common.Interfaces
@using ProgramaLenceria.Domain.Entities
@inject IClienteService ClienteService
@rendermode InteractiveServer

<PageTitle>Clientes - Lencería</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Gestión de Clientes</h3>
    <button class="btn btn-success" @onclick="AbrirModalNuevo">
        <i class="bi bi-plus-circle"></i> + Nuevo Cliente
    </button>
</div>

@if (clientes == null)
{
    <p><em>Cargando clientes...</em></p>
}
else if (!clientes.Any())
{
    <div class="alert alert-info">No hay clientes registrados en el sistema.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tipo</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>
                        @if (c.EsMayorista)
                        {
                            <span class="badge bg-warning text-dark">Mayorista</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">Minorista</span>
                        }
                    </td>
                    <td><strong>@c.Nombre</strong></td>
                    <td>@(c.Telefono ?? "-")</td>
                    <td>@(c.Email ?? "-")</td>
                    <td>@(c.Direccion ?? "-")</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirModalEditar(c)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirModalConfirmarEliminar(c)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* ------------------- MODAL CREAR / EDITAR ------------------- *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">@(esEdicion ? "Editar Cliente" : "Nuevo Cliente")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger">@mensajeError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Nombre Completo / Razón Social</label>
                        <input type="text" class="form-control" @bind="clienteActual.Nombre" placeholder="Ej: Laura Rodriguez" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono</label>
                            <input type="text" class="form-control" @bind="clienteActual.Telefono" placeholder="Ej: 11 9876-5432" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="clienteActual.Email" placeholder="cliente@gmail.com" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input type="text" class="form-control" @bind="clienteActual.Direccion" placeholder="Ej: San Martín 456" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="checkMayorista" @bind="clienteActual.EsMayorista">
                        <label class="form-check-label font-weight-bold" for="checkMayorista">
                            ¿Es Cliente Mayorista? (Aplica reglas de descuento especial)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="GuardarCliente">
                        @(esEdicion ? "Guardar Cambios" : "Guardar Cliente")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ------------------- MODAL CONFIRMAR ELIMINAR ------------------- *@
@if (mostrarModalEliminar && clienteAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que deseas eliminar al cliente <strong>@clienteAEliminar.Nombre</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminacion">Eliminar Definitivamente</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<Cliente>? clientes;
    private bool mostrarModal = false;
    private bool esEdicion = false;
    private string mensajeError = string.Empty;
    private Cliente clienteActual = new();

    private bool mostrarModalEliminar = false;
    private Cliente? clienteAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        clientes = await ClienteService.ObtenerTodosAsync();
    }

    private void AbrirModalNuevo()
    {
        mensajeError = string.Empty;
        esEdicion = false;
        clienteActual = new Cliente();
        mostrarModal = true;
    }

    private void AbrirModalEditar(Cliente c)
    {
        mensajeError = string.Empty;
        esEdicion = true;
        // Clonamos las propiedades para romper la referencia directa
        clienteActual = new Cliente
            {
                Id = c.Id,
                Nombre = c.Nombre,
                Telefono = c.Telefono,
                Email = c.Email,
                Direccion = c.Direccion,
                EsMayorista = c.EsMayorista,
                FechaRegistro = c.FechaRegistro
            };
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarCliente()
    {
        try
        {
            mensajeError = string.Empty;
            if (esEdicion)
                await ClienteService.ActualizarClienteAsync(clienteActual);
            else
                await ClienteService.CrearClienteAsync(clienteActual);

            mostrarModal = false;
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void AbrirModalConfirmarEliminar(Cliente c)
    {
        clienteAEliminar = c;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar() => mostrarModalEliminar = false;

    private async Task ConfirmarEliminacion()
    {
        if (clienteAEliminar != null)
        {
            await ClienteService.EliminarClienteAsync(clienteAEliminar.Id);
            mostrarModalEliminar = false;
            clienteAEliminar = null;
            await CargarClientes();
        }
    }
}