@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
            <span class="text-muted small fw-semibold">
                <i class="bi bi-shop me-1 text-primary"></i> Sistema de Gestión Comercial
            </span>
            <span class="badge bg-light text-dark border">
                @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Ha ocurrido un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
